generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String  @id @default(uuid()) @db.Uuid
  title     String
  content   String
  published Boolean @default(false)

  authorId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}
